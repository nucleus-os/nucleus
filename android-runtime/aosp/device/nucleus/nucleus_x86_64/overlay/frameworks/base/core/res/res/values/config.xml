    <integer name="config_pinnerCameraPinBytes">0</integer>
    <integer name="config_pinnerAssistantPinBytes">0</integer>
    <integer name="config_pinnerWebviewPinBytes">0</integer>
    <integer name="config_pinnerMaxPinnedMemoryPercentage">0</integer>
</resources>
