on early-init
    chown system system /data
    chmod 0771 /data

    mkdir /data/anr 0775 system system
    mkdir /data/tombstones 0775 system system
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/tombstones 0771 root root
    start tombstoned

    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    mkdir /data/property 0700 root root
    mkdir /data/dalvik-cache 0771 root root

    mkdir /data/nucleus 0700 system system

# Nucleus supplies /data as a host-mounted container filesystem, so there is no
# device fstab mount_all command to publish Android's data-ready lifecycle event.
# The platform post-fs-data action initializes user 0 before this action runs;
# a failure there reboots instead of reaching this trigger.
on post-fs-data
    trigger nonencrypted
