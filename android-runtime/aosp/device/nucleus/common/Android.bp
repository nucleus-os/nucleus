soong_namespace {
    imports: ["frameworks/av/services/audiopolicy/config"],
}

filegroup {
    name: "nucleus_cgroups_config",
    srcs: ["cgroups.json"],
    visibility: ["//system/core/libprocessgroup/profiles:__pkg__"],
}

filegroup {
    name: "nucleus_task_profiles_config",
    srcs: ["task_profiles.json"],
    visibility: ["//system/core/libprocessgroup/profiles:__pkg__"],
}

filegroup {
    name: "nucleus_ipc_transport_source",
    srcs: ["native/ipc-transport/NucleusIPCTransportC.c"],
    visibility: ["//device/nucleus/common:__pkg__"],
}

cc_library_shared {
    name: "libnucleus_host_display_jni",
    srcs: [
        "native/host-display/NucleusHostDisplay.cpp",
        "native/ipc-transport/NucleusIPCTransportC.c",
    ],
    include_dirs: [
        "device/nucleus/common/native/display-control-protocol/include",
        "device/nucleus/common/native/gralloc/include",
        "device/nucleus/common/native/ipc-transport/include",
        "device/nucleus/common/native/presentation-protocol/include",
    ],
    shared_libs: [
        "libandroid",
        "liblog",
        "libmediandk",
        "libnativewindow",
    ],
    header_libs: [
        "libcutils_headers",
        "libnativewindow_headers",
    ],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

prebuilt_etc {
    name: "preinstalled-packages-nucleus.xml",
    src: "preinstalled-packages-nucleus.xml",
    sub_dir: "sysconfig",
    product_specific: true,
}

prebuilt_etc {
    name: "audio_policy_configuration.xml",
    src: "audio_policy_configuration.xml",
    vendor: true,
    required: [
        "audio_policy_volumes.xml",
        "bluetooth_audio_policy_configuration_7_0.xml",
        "default_volume_tables.xml",
        "primary_audio_policy_configuration.xml",
        "r_submix_audio_policy_configuration.xml",
        "surround_sound_configuration_5_0.xml",
    ],
}

prebuilt_etc {
    name: "audio_policy_volumes.xml",
    src: "//frameworks/av/services/audiopolicy/config:audio_policy_volumes",
    vendor: true,
}

prebuilt_etc {
    name: "bluetooth_audio_policy_configuration_7_0.xml",
    src: "//frameworks/av/services/audiopolicy/config:bluetooth_audio_policy_configuration_7_0",
    vendor: true,
}

prebuilt_etc {
    name: "default_volume_tables.xml",
    src: "//frameworks/av/services/audiopolicy/config:default_volume_tables",
    vendor: true,
}

prebuilt_etc {
    name: "primary_audio_policy_configuration.xml",
    src: "//frameworks/av/services/audiopolicy/config:primary_audio_policy_configuration",
    vendor: true,
}

prebuilt_etc {
    name: "r_submix_audio_policy_configuration.xml",
    src: "//frameworks/av/services/audiopolicy/config:r_submix_audio_policy_configuration",
    vendor: true,
}

prebuilt_etc {
    name: "surround_sound_configuration_5_0.xml",
    src: "//frameworks/av/services/audiopolicy/config:surround_sound_configuration_5_0",
    vendor: true,
}

cc_library_headers {
    name: "libnucleus_android_gralloc_headers",
    vendor: true,
    export_include_dirs: ["native/gralloc/include"],
}

cc_library_headers {
    name: "libnucleus_android_composer_protocol_headers",
    vendor: true,
    export_include_dirs: ["native/composer-protocol/include"],
}

cc_library_static {
    name: "libnucleus_android_gfxstream_guest_transport",
    vendor: true,
    host_supported: true,
    srcs: [
        "native/gfxstream-guest/GfxstreamSocketTransport.cpp",
        "native/gfxstream-guest/GuestRingFactory.cpp",
        "native/gfxstream-guest/GuestRingStream.cpp",
        "native/ipc-transport/NucleusIPCTransportC.c",
        "native/shared-ring/NucleusAndroidSharedRingC.c",
    ],
    export_include_dirs: [
        "native/gfxstream-guest/include",
        "native/ipc-transport/include",
        "native/shared-ring/include",
    ],
    include_dirs: [
        "external/mesa3d/src/gfxstream/guest/iostream/include",
    ],
    c_std: "c17",
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_library_static {
    name: "libnucleus_android_gralloc_broker_client",
    vendor: true,
    srcs: [
        "native/gralloc/NucleusGrallocBrokerClient.cpp",
        "native/ipc-transport/NucleusIPCTransportC.c",
    ],
    export_include_dirs: [
        "native/gfxstream-guest/include",
        "native/gralloc/include",
        "native/ipc-transport/include",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V3-ndk",
        "libcutils",
    ],
    header_libs: [
        "libdrm_headers",
    ],
    c_std: "c17",
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.nucleus",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["native/gralloc/Allocator.cpp"],
    init_rc: ["native/gralloc/allocator.nucleus.rc"],
    vintf_fragments: ["native/gralloc/allocator.nucleus.xml"],
    static_libs: [
        "libaidlcommonsupport",
        "libnucleus_android_gralloc_broker_client",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdrm",
        "liblog",
    ],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_library_shared {
    name: "mapper.nucleus",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["native/gralloc/Mapper.cpp"],
    vintf_fragments: ["native/gralloc/mapper.nucleus.xml"],
    static_libs: [
        "libnucleus_android_gralloc_broker_client",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V3-ndk",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libcutils",
        "libdrm",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libsync",
    ],
    header_libs: [
        "libimapper_providerutils",
        "libimapper_stablec",
    ],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.graphics.composer3-service.nucleus",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "//device/generic/goldfish:nucleus_hwc3_common_sources",
        "native/composer/Device.cpp",
        "native/composer/DisplayFinder.cpp",
        "native/composer/Main.cpp",
        "native/composer/NucleusFrameComposer.cpp",
        "native/ipc-transport/NucleusIPCTransportC.c",
    ],
    init_rc: ["native/composer/composer.nucleus.rc"],
    vintf_fragments: ["native/composer/composer.nucleus.xml"],
    include_dirs: [
        "device/generic/goldfish/hals/hwc3",
    ],
    local_include_dirs: [
        "native/composer",
        "native/composer-protocol/include",
        "native/gralloc/include",
        "native/ipc-transport/include",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    shared_libs: [
        "android.hardware.graphics.composer@2.1-resources",
        "android.hardware.graphics.composer@2.2-resources",
        "android.hardware.graphics.composer3-V5-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],
    c_std: "c17",
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.health-service.nucleus",
    relative_install_path: "hw",
    vendor: true,
    defaults: ["libhealth_aidl_impl_user"],
    srcs: ["native/health/Main.cpp"],
    init_rc: ["native/health/health.nucleus.rc"],
    vintf_fragments: ["native/health/health.nucleus.xml"],
    static_libs: ["libhealth_aidl_impl"],
    cpp_std: "c++20",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
