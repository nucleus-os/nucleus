+
+#include "nucleus_container.h"
+
+#include <android-base/errors.h>
+#include <android-base/result.h>
+
+#include <array>
+#include <errno.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace android {
+namespace init {
+
+using android::base::ErrnoError;
+using android::base::Error;
+using android::base::Result;
+
+namespace {
+
+Result<void> PrepareDirectory(const char* path) {
+    if (mkdir(path, 0755) != 0 && errno != EEXIST) {
+        return ErrnoError() << "mkdir(\"" << path << "\") failed";
+    }
+
+    struct stat info {};
+    if (lstat(path, &info) != 0) {
+        return ErrnoError() << "lstat(\"" << path << "\") failed";
+    }
+    if (!S_ISDIR(info.st_mode)) {
+        return Error() << "'" << path << "' is not a directory";
+    }
+    if (chown(path, 0, 0) != 0) {
+        return ErrnoError() << "chown(\"" << path << "\") failed";
+    }
+    if (chmod(path, 0755) != 0) {
+        return ErrnoError() << "chmod(\"" << path << "\") failed";
+    }
+    return {};
+}
+
+}  // namespace
+
+Result<void> EnterNucleusContainer() {
+    if (setenv(kNucleusContainerEnvironment, "1", 1) != 0) {
+        return ErrnoError() << "setenv(\"" << kNucleusContainerEnvironment << "\") failed";
+    }
+    umask(0);
+
+    for (const char* path :
+         std::array{"/dev/socket", "/dev/dm-user", "/mnt/vendor", "/mnt/product"}) {
+        auto result = PrepareDirectory(path);
+        if (!result.ok()) {
+            return result;
+        }
+    }
+    return {};
+}
+
+}  // namespace init
+}  // namespace android
