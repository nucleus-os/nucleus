+static bool EvacuateCgroupRoot(const CgroupDescriptor& descriptor) {
+    const std::string& root = descriptor.controller()->path();
+    const std::string init = root + "/init";
+    std::string processes;
+    if (!android::base::ReadFileToString(root + "/cgroup.procs", &processes)) {
+        PLOG(ERROR) << "Failed to read processes from delegated cgroup root";
+        return false;
+    }
+    if (!Mkdir(init, 0, "", "")) {
+        PLOG(ERROR) << "Failed to create delegated init cgroup";
+        return false;
+    }
+    std::istringstream identifiers(processes);
+    for (std::string identifier; identifiers >> identifier;) {
+        if (!android::base::WriteStringToFile(identifier, init + "/cgroup.procs")) {
+            PLOG(ERROR) << "Failed to move PID " << identifier
+                        << " out of delegated cgroup root";
+            return false;
+        }
+    }
+    processes.clear();
+    if (!android::base::ReadFileToString(root + "/cgroup.procs", &processes)) {
+        PLOG(ERROR) << "Failed to verify delegated cgroup root";
+        return false;
+    }
+    if (processes.find_first_not_of(" \t\r\n") != std::string::npos) {
+        LOG(ERROR) << "Delegated cgroup root still contains processes";
+        return false;
+    }
+    return true;
+}
