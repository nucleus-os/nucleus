+TEST_F(UtilsTest, FuseDaemonRegistrationRequiresMountCapability) {
+    int capabilityPipe[2];
+    int unrelatedPipe[2];
+    ASSERT_EQ(0, pipe(capabilityPipe));
+    ASSERT_EQ(0, pipe(unrelatedPipe));
+    android::base::unique_fd capability(capabilityPipe[0]);
+    android::base::unique_fd capabilityPeer(capabilityPipe[1]);
+    android::base::unique_fd unrelated(unrelatedPipe[0]);
+    android::base::unique_fd unrelatedPeer(unrelatedPipe[1]);
+    const std::string mountPath = "/storage/test-fuse-registration";
+
+    ASSERT_EQ(OK, PrepareFuseDaemonRegistration(0, mountPath, capability));
+    EXPECT_EQ(-EPERM,
+              RegisterFuseDaemon("test-session", mountPath, unrelated, getpid()));
+    EXPECT_FALSE(IsFuseDaemon(getpid()));
+
+    ASSERT_EQ(OK, RegisterFuseDaemon("test-session", mountPath, capability, getpid()));
+    EXPECT_TRUE(IsFuseDaemon(getpid()));
+    EXPECT_EQ(OK, UnregisterFuseDaemon("test-session", getpid()));
+    EXPECT_FALSE(IsFuseDaemon(getpid()));
+}
