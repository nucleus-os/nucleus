+namespace {
+
+struct FuseDaemonRegistration {
+    unique_fd pendingFuseFd;
+    userid_t userId;
+    std::string sessionId;
+    pid_t pid = -1;
+    uint64_t processStartTime = 0;
+};
+
+std::mutex gFuseDaemonRegistryLock;
+std::map<std::string, FuseDaemonRegistration> gFuseDaemonRegistry;
+
+std::optional<uint64_t> ReadProcessStartTime(pid_t pid) {
+    std::string stat;
+    if (!ReadFileToString(StringPrintf("/proc/%d/stat", pid), &stat)) {
+        return std::nullopt;
+    }
+
+    const size_t commandEnd = stat.rfind(')');
+    if (commandEnd == std::string::npos || commandEnd + 2 >= stat.size()) {
+        return std::nullopt;
+    }
+    const std::vector<std::string> fields = android::base::Split(stat.substr(commandEnd + 2), " ");
+    // The substring starts at field 3 (state); process start time is field 22.
+    if (fields.size() <= 19) {
+        return std::nullopt;
+    }
+    uint64_t startTime;
+    if (!android::base::ParseUint(fields[19], &startTime)) {
+        return std::nullopt;
+    }
+    return startTime;
+}
+
+bool RefersToSameOpenFileDescription(int firstFd, int secondFd) {
+    return syscall(__NR_kcmp, getpid(), getpid(), KCMP_FILE, firstFd, secondFd) == 0;
+}
+
+}  // namespace
+
+status_t PrepareFuseDaemonRegistration(userid_t userId, const std::string& mountPath,
+                                       const unique_fd& fuseFd) {
+    unique_fd retainedFd(fcntl(fuseFd.get(), F_DUPFD_CLOEXEC, 0));
+    if (!retainedFd.ok()) {
+        PLOG(ERROR) << "Failed to retain FUSE capability for " << mountPath;
+        return -errno;
+    }
+
+    std::lock_guard<std::mutex> lock(gFuseDaemonRegistryLock);
+    gFuseDaemonRegistry[mountPath] = FuseDaemonRegistration{
+            .pendingFuseFd = std::move(retainedFd),
+            .userId = userId,
+    };
+    return OK;
+}
+
+status_t RegisterFuseDaemon(const std::string& sessionId, const std::string& mountPath,
+                            const unique_fd& fuseFd, pid_t callerPid) {
+    if (sessionId.empty() || callerPid <= 0 || !fuseFd.ok()) {
+        return -EINVAL;
+    }
+
+    const std::optional<uint64_t> processStartTime = ReadProcessStartTime(callerPid);
+    if (!processStartTime.has_value()) {
+        return -ESRCH;
+    }
+
+    std::lock_guard<std::mutex> lock(gFuseDaemonRegistryLock);
+    auto registration = gFuseDaemonRegistry.find(mountPath);
+    if (registration == gFuseDaemonRegistry.end() || !registration->second.pendingFuseFd.ok() ||
+        !RefersToSameOpenFileDescription(registration->second.pendingFuseFd.get(), fuseFd.get())) {
+        LOG(WARNING) << "Rejected FUSE daemon registration without the mount capability for "
+                     << mountPath;
+        return -EPERM;
+    }
+    for (const auto& [registeredPath, registeredDaemon] : gFuseDaemonRegistry) {
+        if (registeredPath != mountPath && registeredDaemon.sessionId == sessionId) {
+            LOG(WARNING) << "Rejected duplicate FUSE session registration for " << sessionId;
+            return -EEXIST;
+        }
+    }
+
+    registration->second.pendingFuseFd.reset();
+    registration->second.sessionId = sessionId;
+    registration->second.pid = callerPid;
+    registration->second.processStartTime = *processStartTime;
+    return OK;
+}
+
+status_t UnregisterFuseDaemon(const std::string& sessionId, pid_t callerPid) {
+    const std::optional<uint64_t> processStartTime = ReadProcessStartTime(callerPid);
+    if (!processStartTime.has_value()) {
+        return -ESRCH;
+    }
+
+    std::lock_guard<std::mutex> lock(gFuseDaemonRegistryLock);
+    for (auto registration = gFuseDaemonRegistry.begin();
+         registration != gFuseDaemonRegistry.end(); ++registration) {
+        if (registration->second.sessionId != sessionId) {
+            continue;
+        }
+        if (registration->second.pid != callerPid ||
+            registration->second.processStartTime != *processStartTime) {
+            return -EPERM;
+        }
+        gFuseDaemonRegistry.erase(registration);
+        return OK;
+    }
+    return -ENOENT;
+}
+
+void ForgetFuseDaemonRegistration(const std::string& mountPath) {
+    std::lock_guard<std::mutex> lock(gFuseDaemonRegistryLock);
+    gFuseDaemonRegistry.erase(mountPath);
+}
