+namespace android::vold {
+
+enum class StorageSecurityMode {
+    kAndroidSelinux,
+    kLabelNeutral,
+};
+
+inline StorageSecurityMode GetStorageSecurityMode() {
+    static const StorageSecurityMode mode =
+            android::base::GetBoolProperty("ro.nucleus.container", false)
+            ? StorageSecurityMode::kLabelNeutral
+            : StorageSecurityMode::kAndroidSelinux;
+    return mode;
+}
+
+inline bool IsAndroidSelinuxOperational() {
+    return GetStorageSecurityMode() == StorageSecurityMode::kAndroidSelinux;
+}
+
