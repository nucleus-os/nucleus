From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nucleus Source Lock <source-lock@nucleus.invalid>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Zygote: support the Nucleus container

The host kernel does not run the Android SELinux policy. Preserve the host
process label when specializing Android children inside a Nucleus container.
Stock Android keeps both SELinux transitions.

Change-Id: I530e0ad3e1ba7df463d356db872203600fd55eeb
---
 core/jni/com_android_internal_os_Zygote.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/jni/com_android_internal_os_Zygote.cpp b/core/jni/com_android_internal_os_Zygote.cpp
index 15a7ee4a0a39..3ef258eacb62 100644
--- a/core/jni/com_android_internal_os_Zygote.cpp
+++ b/core/jni/com_android_internal_os_Zygote.cpp
@@ -2171,7 +2171,9 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
 
     const char* se_info_ptr = se_info.has_value() ? se_info.value().c_str() : nullptr;
 
-    if (selinux_android_setcontext(uid, is_system_server, se_info_ptr, nice_name_ptr) == -1) {
+    const bool nucleus_container = GetBoolProperty("ro.nucleus.container", false);
+    if (!nucleus_container &&
+        selinux_android_setcontext(uid, is_system_server, se_info_ptr, nice_name_ptr) == -1) {
         fail_fn(CREATE_ERROR("selinux_android_setcontext(%d, %d, \"%s\", \"%s\") failed", uid,
                              is_system_server, se_info_ptr, nice_name_ptr));
     }
@@ -2203,7 +2205,7 @@ static void SpecializeCommon(JNIEnv* env, uid_t uid, gid_t gid, jintArray gids,
 
         // TODO(b/117874058): Remove hardcoded label here.
         static const char* kSystemServerLabel = "u:r:system_server:s0";
-        if (selinux_android_setcon(kSystemServerLabel) != 0) {
+        if (!nucleus_container && selinux_android_setcon(kSystemServerLabel) != 0) {
             fail_fn(CREATE_ERROR("selinux_android_setcon(%s)", kSystemServerLabel));
         }
     }
-- 
