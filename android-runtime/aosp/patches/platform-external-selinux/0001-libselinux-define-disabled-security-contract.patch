diff --git a/libselinux/src/android/nucleus_disabled_unittest.cpp b/libselinux/src/android/nucleus_disabled_unittest.cpp
new file mode 100644
index 0000000..ab84c41
--- /dev/null
+++ b/libselinux/src/android/nucleus_disabled_unittest.cpp
@@ -0,0 +1,80 @@
+#include <errno.h>
+
+#include <gtest/gtest.h>
+
+#include <android-base/file.h>
+#include <selinux/android.h>
+#include <selinux/selinux.h>
+
+namespace {
+
+constexpr char kSyntheticContext[] = "u:r:nucleus_test:s0";
+
+class DisabledSELinuxTest : public ::testing::Test {
+  protected:
+    void SetUp() override {
+        if (is_selinux_enabled() > 0) {
+            GTEST_SKIP() << "requires a runtime without Android SELinux";
+        }
+    }
+};
+
+TEST_F(DisabledSELinuxTest, RestoreconIsAQuietNoOp) {
+    constexpr char kMissingPath[] =
+            "/data/local/tmp/nucleus-selinux-test-path-that-must-not-exist";
+
+    EXPECT_EQ(0, selinux_android_restorecon(
+                         kMissingPath, SELINUX_ANDROID_RESTORECON_RECURSE));
+    EXPECT_EQ(0, selinux_android_restorecon_pkgdir(
+                         kMissingPath, "platform", 10000,
+                         SELINUX_ANDROID_RESTORECON_RECURSE));
+}
+
+TEST_F(DisabledSELinuxTest, AccessChecksDoNotGrantWithoutPolicy) {
+    errno = 0;
+    EXPECT_EQ(-1, selinux_check_access(
+                          kSyntheticContext, kSyntheticContext,
+                          "service_manager", "find", nullptr));
+    EXPECT_EQ(ENOTSUP, errno);
+}
+
+TEST_F(DisabledSELinuxTest, LabelGettersDoNotFabricateContexts) {
+    TemporaryFile file;
+    ASSERT_NE(-1, file.fd);
+
+    char* context = reinterpret_cast<char*>(1);
+    EXPECT_EQ(-1, getfilecon(file.path, &context));
+    EXPECT_EQ(nullptr, context);
+
+    context = reinterpret_cast<char*>(1);
+    EXPECT_EQ(-1, lgetfilecon(file.path, &context));
+    EXPECT_EQ(nullptr, context);
+
+    context = reinterpret_cast<char*>(1);
+    EXPECT_EQ(-1, fgetfilecon(file.fd, &context));
+    EXPECT_EQ(nullptr, context);
+}
+
+TEST_F(DisabledSELinuxTest, LabelWritersDoNotSilentlySucceed) {
+    TemporaryFile file;
+    ASSERT_NE(-1, file.fd);
+
+    EXPECT_EQ(-1, setfilecon(file.path, kSyntheticContext));
+    EXPECT_EQ(-1, lsetfilecon(file.path, kSyntheticContext));
+    EXPECT_EQ(-1, fsetfilecon(file.fd, kSyntheticContext));
+}
+
+TEST_F(DisabledSELinuxTest, ProcessTransitionsDoNotSilentlySucceed) {
+    EXPECT_EQ(-1, setcon(kSyntheticContext));
+    EXPECT_EQ(-1, setexeccon(kSyntheticContext));
+    EXPECT_EQ(-1, setfscreatecon(kSyntheticContext));
+    EXPECT_EQ(-1, setsockcreatecon(kSyntheticContext));
+}
+
+TEST_F(DisabledSELinuxTest, EnforcementStateIsUnavailable) {
+    errno = 0;
+    EXPECT_EQ(-1, security_getenforce());
+    EXPECT_EQ(ENOENT, errno);
+}
+
+}  // namespace
