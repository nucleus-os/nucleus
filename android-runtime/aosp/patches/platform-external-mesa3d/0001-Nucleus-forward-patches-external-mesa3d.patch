@@ -17,6 +19,23 @@
 
 #define STREAM_BUFFER_SIZE (4 * 1024 * 1024)
 
+static std::atomic<gfxstream_external_iostream_factory> external_iostream_factory;
+static std::atomic<void*> external_iostream_factory_context;
+
+extern "C" void gfxstream_vk_set_external_iostream_factory(
+    gfxstream_external_iostream_factory factory, void* context) {
+    external_iostream_factory_context.store(context, std::memory_order_relaxed);
+    external_iostream_factory.store(factory, std::memory_order_release);
+}
+
+extern "C" int gfxstream_vk_has_external_iostream_factory(void) {
+    return external_iostream_factory.load(std::memory_order_acquire) != nullptr;
+}
+
+bool gfxstream_vk_has_external_iostream_factory_internal() {
+    return external_iostream_factory.load(std::memory_order_acquire) != nullptr;
+}
+
 static tss_t gfxstream_connection_manager_tls_key;
 static bool gfxstream_connection_manager_tls_key_valid;
 
@@ -145,6 +164,21 @@ bool GfxStreamConnectionManager::initialize() {
 
             break;
         }
+        case GFXSTREAM_TRANSPORT_EXTERNAL_IOSTREAM: {
+            const auto factory = external_iostream_factory.load(std::memory_order_acquire);
+            if (!factory) {
+                mesa_loge("External IOStream factory is not installed\n");
+                return false;
+            }
+            mStream = static_cast<gfxstream::guest::IOStream*>(
+                factory(external_iostream_factory_context.load(std::memory_order_relaxed),
+                        STREAM_BUFFER_SIZE));
+            if (!mStream) {
+                mesa_loge("External IOStream factory failed\n");
+                return false;
+            }
+            break;
+        }
         default:
             return false;
     }
@@ -187,6 +221,15 @@ gfxstream::guest::IOStream* GfxStreamConnectionManager::processPipeStream(
         case GFXSTREAM_TRANSPORT_VIRTIO_GPU_ADDRESS_SPACE:
         case GFXSTREAM_TRANSPORT_VIRTIO_GPU_PIPE:
             return new VirtioGpuPipeStream(STREAM_BUFFER_SIZE, mDescriptor);
+        case GFXSTREAM_TRANSPORT_EXTERNAL_IOSTREAM: {
+            const auto factory = external_iostream_factory.load(std::memory_order_acquire);
+            return factory
+                       ? static_cast<gfxstream::guest::IOStream*>(
+                             factory(external_iostream_factory_context.load(
+                                         std::memory_order_relaxed),
+                                     STREAM_BUFFER_SIZE))
+                       : nullptr;
+        }
         default:
             return nullptr;
     }
