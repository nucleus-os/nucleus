diff --git a/src/gfxstream/guest/android/GrallocNucleus.cpp b/src/gfxstream/guest/android/GrallocNucleus.cpp
new file mode 100644
index 00000000000..ae777e18a07
--- /dev/null
+++ b/src/gfxstream/guest/android/GrallocNucleus.cpp
@@ -0,0 +1,146 @@
+#include "GrallocNucleus.h"
+
+#include <NucleusGrallocHandle.h>
+#include <vndk/hardware_buffer.h>
+
+namespace gfxstream {
+
+namespace {
+const nucleus_gralloc_handle *handle(const native_handle_t *native) {
+    return nucleus_gralloc_handle_cast(native);
+}
+}
+
+GrallocType NucleusGralloc::getGrallocType() {
+    return GRALLOC_TYPE_NUCLEUS;
+}
+
+uint32_t NucleusGralloc::createColorBuffer(int, int, uint32_t) {
+    return 0;
+}
+
+int NucleusGralloc::allocate(
+    uint32_t width,
+    uint32_t height,
+    uint32_t format,
+    uint64_t usage,
+    AHardwareBuffer **output) {
+    const AHardwareBuffer_Desc description = {
+        .width = width,
+        .height = height,
+        .layers = 1,
+        .format = format,
+        .usage = usage,
+    };
+    return AHardwareBuffer_allocate(&description, output);
+}
+
+void NucleusGralloc::acquire(AHardwareBuffer *buffer) {
+    AHardwareBuffer_acquire(buffer);
+}
+
+void NucleusGralloc::release(AHardwareBuffer *buffer) {
+    AHardwareBuffer_release(buffer);
+}
+
+int NucleusGralloc::lock(AHardwareBuffer *buffer, uint8_t **output) {
+    return AHardwareBuffer_lock(
+        buffer,
+        AHARDWAREBUFFER_USAGE_CPU_READ_RARELY,
+        -1,
+        nullptr,
+        reinterpret_cast<void **>(output));
+}
+
+int NucleusGralloc::lockPlanes(
+    AHardwareBuffer *,
+    std::vector<LockedPlane> *) {
+    return -1;
+}
+
+int NucleusGralloc::unlock(AHardwareBuffer *buffer) {
+    return AHardwareBuffer_unlock(buffer, nullptr);
+}
+
+const native_handle_t *NucleusGralloc::getNativeHandle(
+    const AHardwareBuffer *buffer) {
+    return AHardwareBuffer_getNativeHandle(buffer);
+}
+
+uint32_t NucleusGralloc::getHostHandle(
+    const native_handle_t *native) {
+    const auto *nucleus = handle(native);
+    return nucleus == nullptr ? 0 : nucleus->color_buffer_handle;
+}
+
+uint32_t NucleusGralloc::getHostHandle(
+    const AHardwareBuffer *buffer) {
+    return getHostHandle(AHardwareBuffer_getNativeHandle(buffer));
+}
+
+int NucleusGralloc::getFormat(const native_handle_t *native) {
+    const auto *nucleus = handle(native);
+    return nucleus == nullptr ? 0 : nucleus->android_format;
+}
+
+int NucleusGralloc::getFormat(const AHardwareBuffer *buffer) {
+    return getFormat(AHardwareBuffer_getNativeHandle(buffer));
+}
+
+uint32_t NucleusGralloc::getFormatDrmFourcc(
+    const native_handle_t *native) {
+    const auto *nucleus = handle(native);
+    return nucleus == nullptr ? 0 : nucleus->drm_format;
+}
+
+uint32_t NucleusGralloc::getFormatDrmFourcc(
+    const AHardwareBuffer *buffer) {
+    return getFormatDrmFourcc(
+        AHardwareBuffer_getNativeHandle(buffer));
+}
+
+uint32_t NucleusGralloc::getWidth(const AHardwareBuffer *buffer) {
+    AHardwareBuffer_Desc description = {};
+    AHardwareBuffer_describe(buffer, &description);
+    return description.width;
+}
+
+uint32_t NucleusGralloc::getHeight(const AHardwareBuffer *buffer) {
+    AHardwareBuffer_Desc description = {};
+    AHardwareBuffer_describe(buffer, &description);
+    return description.height;
+}
+
+size_t NucleusGralloc::getAllocatedSize(
+    const native_handle_t *native) {
+    const auto *nucleus = handle(native);
+    return nucleus == nullptr ? 0 : nucleus->allocation_size;
+}
+
+size_t NucleusGralloc::getAllocatedSize(
+    const AHardwareBuffer *buffer) {
+    return getAllocatedSize(AHardwareBuffer_getNativeHandle(buffer));
+}
+
+int NucleusGralloc::getId(
+    const AHardwareBuffer *buffer,
+    uint64_t *identifier) {
+    const auto *nucleus =
+        handle(AHardwareBuffer_getNativeHandle(buffer));
+    if (nucleus == nullptr) {
+        return -1;
+    }
+    *identifier = nucleus->allocation_id;
+    return 0;
+}
+
+int32_t NucleusGralloc::getDataspace(
+    const AHardwareBuffer *buffer) {
+    const auto *nucleus =
+        handle(AHardwareBuffer_getNativeHandle(buffer));
+    return nucleus == nullptr
+               ? GFXSTREAM_AHB_DATASPACE_UNKNOWN
+               : nucleus->dataspace;
+}
+
+}  // namespace gfxstream
diff --git a/src/gfxstream/guest/android/GrallocNucleus.h b/src/gfxstream/guest/android/GrallocNucleus.h
new file mode 100644
index 00000000000..1e664c34d57
--- /dev/null
+++ b/src/gfxstream/guest/android/GrallocNucleus.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "gfxstream/guest/GfxStreamGralloc.h"
+
+namespace gfxstream {
+
+class NucleusGralloc final : public Gralloc {
+  public:
+    GrallocType getGrallocType() override;
+    uint32_t createColorBuffer(int, int, uint32_t) override;
+    int allocate(
+        uint32_t,
+        uint32_t,
+        uint32_t,
+        uint64_t,
+        AHardwareBuffer **) override;
+    void acquire(AHardwareBuffer *) override;
+    void release(AHardwareBuffer *) override;
+    int lock(AHardwareBuffer *, uint8_t **) override;
+    int lockPlanes(
+        AHardwareBuffer *,
+        std::vector<LockedPlane> *) override;
+    int unlock(AHardwareBuffer *) override;
+    const native_handle_t *getNativeHandle(
+        const AHardwareBuffer *) override;
+    uint32_t getHostHandle(const native_handle_t *) override;
+    uint32_t getHostHandle(const AHardwareBuffer *) override;
+    int getFormat(const native_handle_t *) override;
+    int getFormat(const AHardwareBuffer *) override;
+    uint32_t getFormatDrmFourcc(const native_handle_t *) override;
+    uint32_t getFormatDrmFourcc(const AHardwareBuffer *) override;
+    uint32_t getWidth(const AHardwareBuffer *) override;
+    uint32_t getHeight(const AHardwareBuffer *) override;
+    size_t getAllocatedSize(const native_handle_t *) override;
+    size_t getAllocatedSize(const AHardwareBuffer *) override;
+    int getId(const AHardwareBuffer *, uint64_t *) override;
+    int32_t getDataspace(const AHardwareBuffer *) override;
+};
+
+}  // namespace gfxstream
