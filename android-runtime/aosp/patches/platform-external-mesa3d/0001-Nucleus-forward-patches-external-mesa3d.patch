diff --git a/src/gfxstream/guest/connection-manager/GfxStreamConnectionManager.cpp b/src/gfxstream/guest/connection-manager/GfxStreamConnectionManager.cpp
index 37a52ffe5de..ffc2a7dd9ce 100644
--- a/src/gfxstream/guest/connection-manager/GfxStreamConnectionManager.cpp
+++ b/src/gfxstream/guest/connection-manager/GfxStreamConnectionManager.cpp
@@ -5,8 +5,10 @@
 
 #include "GfxStreamConnectionManager.h"
 
+#include <atomic>
 #include <cerrno>
 
+#include "GfxStreamExternalIOStream.h"
 #include "GoldfishAddressSpaceStream.h"
 #include "QemuPipeStream.h"
 #include "VirtGpu.h"
@@ -17,6 +19,146 @@
 
 #define STREAM_BUFFER_SIZE (4 * 1024 * 1024)
 
+static std::atomic<gfxstream_external_iostream_factory> external_iostream_factory;
+static std::atomic<void*> external_iostream_factory_context;
+static std::atomic<gfxstream_external_memory_mapper> external_memory_mapper;
+static std::atomic<gfxstream_external_memory_unmapper> external_memory_unmapper;
+static std::atomic<void*> external_memory_context;
+static std::atomic<gfxstream_external_vulkan_fence_exporter>
+    external_vulkan_fence_exporter;
+static std::atomic<void*> external_vulkan_fence_context;
+static std::atomic<gfxstream_external_vulkan_semaphore_exporter>
+    external_vulkan_semaphore_exporter;
+static std::atomic<void*> external_vulkan_semaphore_context;
+static std::atomic<gfxstream_external_vulkan_qsri_exporter>
+    external_vulkan_qsri_exporter;
+static std::atomic<void*> external_vulkan_qsri_context;
+
+extern "C" void gfxstream_vk_set_external_iostream_factory(
+    gfxstream_external_iostream_factory factory, void* context) {
+    external_iostream_factory_context.store(context, std::memory_order_relaxed);
+    external_iostream_factory.store(factory, std::memory_order_release);
+}
+
+extern "C" int gfxstream_vk_has_external_iostream_factory(void) {
+    return external_iostream_factory.load(std::memory_order_acquire) != nullptr;
+}
+
+extern "C" void gfxstream_vk_set_external_memory_mapper(
+    gfxstream_external_memory_mapper mapper,
+    gfxstream_external_memory_unmapper unmapper,
+    void* context) {
+    external_memory_context.store(context, std::memory_order_relaxed);
+    external_memory_unmapper.store(unmapper, std::memory_order_relaxed);
+    external_memory_mapper.store(mapper, std::memory_order_release);
+}
+
+extern "C" void gfxstream_vk_set_external_vulkan_fence_exporter(
+    gfxstream_external_vulkan_fence_exporter exporter, void* context) {
+    external_vulkan_fence_context.store(context, std::memory_order_relaxed);
+    external_vulkan_fence_exporter.store(exporter, std::memory_order_release);
+}
+
+extern "C" void gfxstream_vk_set_external_vulkan_semaphore_exporter(
+    gfxstream_external_vulkan_semaphore_exporter exporter, void* context) {
+    external_vulkan_semaphore_context.store(
+        context, std::memory_order_relaxed);
+    external_vulkan_semaphore_exporter.store(
+        exporter, std::memory_order_release);
+}
+
+extern "C" void gfxstream_vk_set_external_vulkan_qsri_exporter(
+    gfxstream_external_vulkan_qsri_exporter exporter, void* context) {
+    external_vulkan_qsri_context.store(context, std::memory_order_relaxed);
+    external_vulkan_qsri_exporter.store(exporter, std::memory_order_release);
+}
+
+bool gfxstream_vk_has_external_iostream_factory_internal() {
+    return external_iostream_factory.load(std::memory_order_acquire) != nullptr;
+}
+
+bool gfxstream_vk_has_external_memory_mapper_internal() {
+    return external_memory_mapper.load(std::memory_order_acquire) != nullptr;
+}
+
+bool gfxstream_vk_has_external_vulkan_fence_exporter_internal() {
+    return external_vulkan_fence_exporter.load(std::memory_order_acquire) != nullptr;
+}
+
+bool gfxstream_vk_has_external_vulkan_semaphore_exporter_internal() {
+    return external_vulkan_semaphore_exporter.load(
+               std::memory_order_acquire) != nullptr;
+}
+
+bool gfxstream_vk_has_external_vulkan_qsri_exporter_internal() {
+    return external_vulkan_qsri_exporter.load(
+               std::memory_order_acquire) != nullptr;
+}
+
+int gfxstream_vk_map_external_memory(uint64_t blobId, size_t size, void** address) {
+    const auto mapper = external_memory_mapper.load(std::memory_order_acquire);
+    if (!mapper) {
+        return -1;
+    }
+    return mapper(
+        external_memory_context.load(std::memory_order_relaxed),
+        blobId,
+        size,
+        address);
+}
+
+void gfxstream_vk_unmap_external_memory(void* address, size_t size) {
+    const auto unmapper = external_memory_unmapper.load(std::memory_order_acquire);
+    if (unmapper) {
+        unmapper(
+            external_memory_context.load(std::memory_order_relaxed),
+            address,
+            size);
+    }
+}
+
+int gfxstream_vk_export_external_vulkan_fence(
+    uint64_t deviceHandle, uint64_t fenceHandle) {
+    const auto exporter =
+        external_vulkan_fence_exporter.load(std::memory_order_acquire);
+    if (!exporter) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    return exporter(
+        external_vulkan_fence_context.load(std::memory_order_relaxed),
+        deviceHandle,
+        fenceHandle);
+}
+
+int gfxstream_vk_export_external_vulkan_semaphore(
+    uint64_t deviceHandle, uint64_t semaphoreHandle) {
+    const auto exporter =
+        external_vulkan_semaphore_exporter.load(
+            std::memory_order_acquire);
+    if (!exporter) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    return exporter(
+        external_vulkan_semaphore_context.load(
+            std::memory_order_relaxed),
+        deviceHandle,
+        semaphoreHandle);
+}
+
+int gfxstream_vk_export_external_vulkan_qsri(uint64_t imageHandle) {
+    const auto exporter =
+        external_vulkan_qsri_exporter.load(std::memory_order_acquire);
+    if (!exporter) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    return exporter(
+        external_vulkan_qsri_context.load(std::memory_order_relaxed),
+        imageHandle);
+}
+
 static tss_t gfxstream_connection_manager_tls_key;
 static bool gfxstream_connection_manager_tls_key_valid;
 
@@ -145,6 +287,21 @@ bool GfxStreamConnectionManager::initialize() {
 
             break;
         }
+        case GFXSTREAM_TRANSPORT_EXTERNAL_IOSTREAM: {
