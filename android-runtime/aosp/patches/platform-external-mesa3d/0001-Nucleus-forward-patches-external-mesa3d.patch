diff --git a/src/gfxstream/guest/connection-manager/GfxStreamExternalIOStream.h b/src/gfxstream/guest/connection-manager/GfxStreamExternalIOStream.h
new file mode 100644
index 00000000000..54b169d039f
--- /dev/null
+++ b/src/gfxstream/guest/connection-manager/GfxStreamExternalIOStream.h
@@ -0,0 +1,75 @@
+/*
+ * Copyright 2026 Nucleus contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef GFXSTREAM_EXTERNAL_IOSTREAM_H
+#define GFXSTREAM_EXTERNAL_IOSTREAM_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#if defined(__GNUC__)
+#define GFXSTREAM_EXTERNAL_API __attribute__((visibility("default")))
+#else
+#define GFXSTREAM_EXTERNAL_API
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void* (*gfxstream_external_iostream_factory)(void* context, size_t buffer_size);
+
+typedef int (*gfxstream_external_memory_mapper)(
+    void* context, uint64_t blob_id, size_t size, void** address);
+
+typedef void (*gfxstream_external_memory_unmapper)(
+    void* context, void* address, size_t size);
+
+typedef int (*gfxstream_external_vulkan_fence_exporter)(
+    void* context, uint64_t device_handle, uint64_t fence_handle);
+
+typedef int (*gfxstream_external_vulkan_semaphore_exporter)(
+    void* context, uint64_t device_handle, uint64_t semaphore_handle);
+
+typedef int (*gfxstream_external_vulkan_qsri_exporter)(
+    void* context, uint64_t image_handle);
+
+GFXSTREAM_EXTERNAL_API void gfxstream_vk_set_external_iostream_factory(
+    gfxstream_external_iostream_factory factory, void* context);
+
+GFXSTREAM_EXTERNAL_API void gfxstream_vk_set_external_memory_mapper(
+    gfxstream_external_memory_mapper mapper,
+    gfxstream_external_memory_unmapper unmapper,
+    void* context);
+
+GFXSTREAM_EXTERNAL_API void gfxstream_vk_set_external_vulkan_fence_exporter(
+    gfxstream_external_vulkan_fence_exporter exporter, void* context);
+
+GFXSTREAM_EXTERNAL_API void gfxstream_vk_set_external_vulkan_semaphore_exporter(
+    gfxstream_external_vulkan_semaphore_exporter exporter, void* context);
+
+GFXSTREAM_EXTERNAL_API void gfxstream_vk_set_external_vulkan_qsri_exporter(
+    gfxstream_external_vulkan_qsri_exporter exporter, void* context);
+
+GFXSTREAM_EXTERNAL_API int gfxstream_vk_has_external_iostream_factory(void);
+
+#ifdef __cplusplus
+}
+
+bool gfxstream_vk_has_external_iostream_factory_internal();
+bool gfxstream_vk_has_external_memory_mapper_internal();
+bool gfxstream_vk_has_external_vulkan_fence_exporter_internal();
+bool gfxstream_vk_has_external_vulkan_semaphore_exporter_internal();
+bool gfxstream_vk_has_external_vulkan_qsri_exporter_internal();
+int gfxstream_vk_map_external_memory(uint64_t blob_id, size_t size, void** address);
+void gfxstream_vk_unmap_external_memory(void* address, size_t size);
+int gfxstream_vk_export_external_vulkan_fence(
+    uint64_t device_handle, uint64_t fence_handle);
+int gfxstream_vk_export_external_vulkan_semaphore(
+    uint64_t device_handle, uint64_t semaphore_handle);
+int gfxstream_vk_export_external_vulkan_qsri(uint64_t image_handle);
+#endif
+
+#endif
