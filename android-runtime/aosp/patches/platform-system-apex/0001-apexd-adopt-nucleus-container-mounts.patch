+Result<MountedApexData> FindNucleusContainerShimMount(const ApexFile& apex) {
+  const auto& manifest = apex.GetManifest();
+  const auto expected_mount_point =
+      apexd_private::GetPackageMountPoint(manifest);
+
+  std::ifstream mounts("/proc/mounts");
+  if (!mounts.is_open()) {
+    return ErrnoError() << "Failed to open /proc/mounts";
+  }
+
+  std::string line;
+  while (std::getline(mounts, line)) {
+    auto mount_info = ParseMountInfo(line);
+    if (!mount_info ||
+        mount_info->mount_point.native() != expected_mount_point) {
+      continue;
+    }
+
+    if (mount_info->fs != "ext4") {
+      return Error() << "Nucleus container shim APEX mount is not ext4: "
+                     << expected_mount_point;
+    }
+    if (!StartsWith(mount_info->device.native(),
+                    "/apex/.nucleus-loop-")) {
+      return Error()
+             << "Nucleus container shim APEX has an unexpected mount source: "
+             << mount_info->device;
+    }
+    const auto mount_options =
+        android::base::Split(mount_info->mount_options, ",");
+    if (std::find(mount_options.begin(), mount_options.end(), "ro") ==
+        mount_options.end()) {
+      return Error() << "Nucleus container shim APEX mount is not read-only: "
+                     << expected_mount_point;
+    }
+
+    return MountedApexData(manifest.version(), "", apex.GetPath(),
+                           expected_mount_point, "", "");
+  }
+
+  return Error() << "Nucleus container shim APEX is not pre-mounted: "
+                 << apex.GetPath();
+}
+
+Result<std::vector<ApexFileRef>> AdoptNucleusContainerApexes(
+    ApexFileRepository& instance) {
+  gMountedApexes.PopulateFromMounts();
+
+  std::vector<ApexFileRef> result;
+  const auto& preinstalled = instance.GetPreInstalledApexFiles();
+  result.reserve(preinstalled.size());
+  for (const auto& apex_ref : preinstalled) {
+    const ApexFile& apex = apex_ref.get();
+    if (apex.IsCompressed()) {
+      return Error() << "Nucleus container APEX must be uncompressed: "
+                     << apex.GetPath();
+    }
+    const auto& manifest = apex.GetManifest();
+    auto mounted = gMountedApexes.GetLatestMountedApex(manifest.name());
+    bool register_mount = false;
+    if (!mounted.has_value()) {
+      if (!shim::IsShimApex(apex)) {
+        return Error() << "Nucleus container APEX is not pre-mounted: "
+                       << apex.GetPath();
+      }
+      mounted = OR_RETURN(FindNucleusContainerShimMount(apex));
+      register_mount = true;
+    }
+    if (mounted->version != manifest.version() ||
+        mounted->full_path != apex.GetPath() ||
+        mounted->mount_point !=
+            apexd_private::GetPackageMountPoint(manifest)) {
+      return Error() << "Nucleus container APEX mount does not match "
+                     << apex.GetPath();
+    }
+    OR_RETURN(VerifyMountedImage(apex, mounted->mount_point));
+    OR_RETURN(VerifyPackageBoot(apex, &mounted->mount_point));
+    if (register_mount) {
+      gMountedApexes.AddMountedApex(manifest.name(), *mounted);
+    }
+    result.push_back(apex_ref);
+  }
+  return result;
+}
