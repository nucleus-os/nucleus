+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "SelinuxUtils.h"
+
+#include <memory>
+
+#include <android-base/properties.h>
+#include <selinux/android.h>
+#include <selinux/selinux.h>
+
+namespace android::installd {
+
+bool IsAndroidSelinuxOperational() {
+    static const bool operational =
+            !android::base::GetBoolProperty("ro.nucleus.container", false);
+    return operational;
+}
+
+int Restorecon(const char* path, unsigned int flags) {
+    if (!IsAndroidSelinuxOperational()) {
+        return 0;
+    }
+    return selinux_android_restorecon(path, flags);
+}
+
+int RestoreconPackage(const char* path, const char* seInfo, uid_t uid, unsigned int flags) {
+    if (!IsAndroidSelinuxOperational()) {
+        return 0;
+    }
+    return selinux_android_restorecon_pkgdir(path, seInfo, uid, flags);
+}
+
+std::optional<std::string> ReadFileContext(const char* path) {
+    if (!IsAndroidSelinuxOperational()) {
+        return std::nullopt;
+    }
+
+    char* rawContext = nullptr;
+    if (lgetfilecon(path, &rawContext) < 0) {
+        return std::nullopt;
+    }
+    std::unique_ptr<char, decltype(&freecon)> context(rawContext, freecon);
+    return std::string(context.get());
+}
+
+int CopyFileContextToSymlink(const char* source, const char* destination) {
+    if (!IsAndroidSelinuxOperational()) {
+        return 0;
+    }
+
+    auto context = ReadFileContext(source);
+    if (!context) {
+        return -1;
+    }
+    return lsetfilecon(destination, context->c_str());
+}
+
+}  // namespace android::installd
