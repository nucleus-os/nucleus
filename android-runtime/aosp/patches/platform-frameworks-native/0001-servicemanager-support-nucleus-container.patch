+    sp<BBinder> binder = sp<BBinder>::make();
+    binder->setRequestingSid(true);
+
+    Parcel parcel;
+    ASSERT_EQ(OK, parcel.writeStrongBinder(binder));
+    ASSERT_GE(parcel.dataSize(), sizeof(flat_binder_object));
+
+    const auto* object = reinterpret_cast<const flat_binder_object*>(parcel.data());
+    const bool transportsSecurityContext =
+            (object->flags & FLAT_BINDER_FLAG_TXN_SECURITY_CTX) != 0;
+    const bool expected =
+            !android::base::GetBoolProperty("ro.nucleus.container", false);
+    EXPECT_EQ(expected, transportsSecurityContext);
+}
