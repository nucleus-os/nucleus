diff --git a/cmds/servicemanager/main.cpp b/cmds/servicemanager/main.cpp
index df5a8ed0d1..0b02a78492 100644
--- a/cmds/servicemanager/main.cpp
+++ b/cmds/servicemanager/main.cpp
@@ -164,14 +164,23 @@ int main(int argc, char** argv) {
 
     IPCThreadState::self()->disableBackgroundScheduling(true);
 
-    sp<ServiceManager> manager = sp<ServiceManager>::make(std::make_unique<Access>());
-    manager->setRequestingSid(true);
+    const bool isNucleusContainer =
+            android::base::GetBoolProperty("ro.nucleus.container", false);
+    if (isNucleusContainer) {
+        LOG(WARNING) << "Using permissive service-manager access in the Nucleus container";
+    }
+    const Access::Mode accessMode =
+            isNucleusContainer ? Access::Mode::kPermissive : Access::Mode::kSELinux;
+    const bool requestSid = !isNucleusContainer;
+    sp<ServiceManager> manager =
+            sp<ServiceManager>::make(std::make_unique<Access>(accessMode));
+    manager->setRequestingSid(requestSid);
     if (!manager->addService("manager", manager, false /*allowIsolated*/, IServiceManager::DUMP_FLAG_PRIORITY_DEFAULT).isOk()) {
         LOG(ERROR) << "Could not self register servicemanager";
     }
 
     IPCThreadState::self()->setTheContextObject(manager);
-    if (!ps->becomeContextManager()) {
+    if (!ps->becomeContextManager(requestSid)) {
         LOG(FATAL) << "Could not become context manager";
     }
 
