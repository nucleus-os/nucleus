+
+#if defined(__ANDROID__)
+#include <string.h>
+#include <sys/system_properties.h>
+#endif
+
+namespace android::binder::internal {
+
+bool transactionSecurityContextsAvailable() {
+#if defined(__ANDROID__)
+    static const bool available = [] {
+        char value[PROP_VALUE_MAX] = {};
+        const int length = __system_property_get("ro.nucleus.container", value);
+        return length <= 0 || strcmp(value, "true") != 0;
+    }();
+    return available;
+#else
+    return true;
+#endif
+}
+
+}  // namespace android::binder::internal
