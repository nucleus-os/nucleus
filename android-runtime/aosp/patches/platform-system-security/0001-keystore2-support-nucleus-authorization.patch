+const AID_ROOT: AppUid = AppUid(rustutils::android::users::AID_ROOT as i64);
+const AID_SYSTEM: AppUid = AppUid(rustutils::android::users::AID_SYSTEM as i64);
+const AID_WIFI: AppUid = AppUid(1010);
+const AID_CREDSTORE: AppUid = AppUid(1076);
+const AID_SHELL: AppUid = AppUid(rustutils::android::users::AID_SHELL as i64);
+
+fn nucleus_denied(
+    caller_uid: AppUid,
+    operation: &str,
+    namespace: Option<i64>,
+) -> anyhow::Error {
+    warn!(
+        "Nucleus Keystore authorization denied: uid={}, operation={}, namespace={}",
+        caller_uid.0,
+        operation,
+        namespace.map_or_else(|| "-".to_string(), |value| value.to_string())
+    );
+    selinux::Error::perm().into()
+}
+
+fn nucleus_app_key_permission(caller_uid: AppUid, perm: KeyPerm) -> bool {
+    matches!(
+        perm,
+        KeyPerm::Delete
+            | KeyPerm::GetInfo
+            | KeyPerm::Grant
+            | KeyPerm::Rebind
+            | KeyPerm::Update
+            | KeyPerm::Use
+    ) || (caller_uid == AID_SYSTEM && perm == KeyPerm::UseDevId)
+}
+
+fn nucleus_platform_key_permission(caller_uid: AppUid, namespace: i64, perm: KeyPerm) -> bool {
+    match namespace {
+        // The su namespace exists only for SELinux-native tests. It has no
+        // production owner in the Nucleus container.
+        0 => false,
+        1 => {
+            caller_uid == AID_SHELL
+                && matches!(
+                    perm,
+                    KeyPerm::Delete
+                        | KeyPerm::GetInfo
+                        | KeyPerm::Rebind
+                        | KeyPerm::Update
+                        | KeyPerm::Use
+                )
+        }
+        100 => {
+            caller_uid == AID_ROOT
+                && matches!(
+                    perm,
+                    KeyPerm::ConvertStorageKeyToEphemeral
+                        | KeyPerm::Delete
+                        | KeyPerm::GetInfo
+                        | KeyPerm::ManageBlob
+                        | KeyPerm::Rebind
+                        | KeyPerm::ReqForcedOp
+                        | KeyPerm::Update
+                        | KeyPerm::Use
+                )
+        }
+        101 => {
+            caller_uid == AID_ROOT
+                && matches!(
+                    perm,
+                    KeyPerm::Delete | KeyPerm::GetInfo | KeyPerm::Rebind | KeyPerm::Use
+                )
+        }
+        102 => {
+            (caller_uid == AID_SYSTEM
+                && matches!(
+                    perm,
+                    KeyPerm::Delete
+                        | KeyPerm::GetInfo
+                        | KeyPerm::Rebind
+                        | KeyPerm::Update
+                        | KeyPerm::Use
+                ))
+                || (caller_uid == AID_WIFI
+                    && matches!(perm, KeyPerm::GetInfo | KeyPerm::Use))
+        }
+        103 | 120 => {
+            caller_uid == AID_SYSTEM
+                && matches!(
+                    perm,
+                    KeyPerm::Delete
+                        | KeyPerm::GetInfo
+                        | KeyPerm::Rebind
+                        | KeyPerm::Update
+                        | KeyPerm::Use
+                )
+        }
+        104 => {
+            caller_uid == AID_SYSTEM
+                && matches!(
+                    perm,
+                    KeyPerm::Delete
+                        | KeyPerm::GetInfo
+                        | KeyPerm::Grant
+                        | KeyPerm::Rebind
+                        | KeyPerm::Update
+                        | KeyPerm::Use
+                )
+        }
+        _ => false,
+    }
+}
+
+fn nucleus_key_permission(
+    caller_uid: AppUid,
+    key: &KeyDescriptor,
+    perm: KeyPerm,
+) -> bool {
+    match key.domain {
+        Domain::APP => caller_uid.0 == key.nspace && nucleus_app_key_permission(caller_uid, perm),
+        Domain::SELINUX | Domain::BLOB => {
+            nucleus_platform_key_permission(caller_uid, key.nspace, perm)
+        }
+        _ => false,
+    }
+}
+
+/// Checks a service-level Keystore permission against the Nucleus caller-UID policy.
+pub fn check_nucleus_keystore_permission(
+    caller_uid: AppUid,
+    perm: KeystorePerm,
+) -> anyhow::Result<()> {
+    let allowed = match caller_uid {
+        AID_SYSTEM => matches!(
+            perm,
+            KeystorePerm::AddAuth
+                | KeystorePerm::ChangePassword
+                | KeystorePerm::ChangeUser
+                | KeystorePerm::ClearNs
+                | KeystorePerm::ClearUID
+                | KeystorePerm::DeleteAllKeys
+                | KeystorePerm::GetLastAuthTime
+                | KeystorePerm::Lock
+                | KeystorePerm::PullMetrics
+                | KeystorePerm::Reset
+                | KeystorePerm::Unlock
+        ),
+        AID_ROOT => matches!(perm, KeystorePerm::EarlyBootEnded | KeystorePerm::DeleteAllKeys),
+        AID_CREDSTORE => perm == KeystorePerm::GetAuthToken,
+        _ => false,
+    };
+    if allowed {
+        Ok(())
+    } else {
+        Err(nucleus_denied(caller_uid, perm.name(), None))
+    }
+}
+
+/// Checks whether a Nucleus caller may grant the requested key permissions.
+pub fn check_nucleus_grant_permission(
+    caller_uid: AppUid,
+    access_vec: KeyPermSet,
+    key: &KeyDescriptor,
+) -> anyhow::Result<()> {
+    if !nucleus_key_permission(caller_uid, key, KeyPerm::Grant) {
+        return Err(nucleus_denied(caller_uid, KeyPerm::Grant.name(), Some(key.nspace)));
+    }
+    if access_vec.includes(KeyPerm::Grant) {
+        return Err(nucleus_denied(caller_uid, KeyPerm::Grant.name(), Some(key.nspace)));
+    }
+    for perm in access_vec {
+        if !nucleus_key_permission(caller_uid, key, perm) {
+            return Err(nucleus_denied(caller_uid, perm.name(), Some(key.nspace)));
+        }
+    }
+    Ok(())
+}
+
+/// Checks access to a key descriptor against the Nucleus UID and namespace policy.
+pub fn check_nucleus_key_permission(
+    caller_uid: AppUid,
+    perm: KeyPerm,
+    key: &KeyDescriptor,
+    access_vector: &Option<KeyPermSet>,
+) -> anyhow::Result<()> {
+    if let Some(access_vector) = access_vector {
+        if access_vector.includes(perm) {
+            return Ok(());
+        }
+    }
+
+    match key.domain {
+        Domain::GRANT => {
+            if access_vector.is_none() {
+                return Err(KsError::sys()).context(ks_err!(
+                    "Cannot check permission for Domain::GRANT without access vector.",
+                ));
+            }
+        }
+        Domain::KEY_ID => {
+            return Err(KsError::sys())
+                .context(ks_err!("Cannot check permission for Domain::KEY_ID.",));
+        }
+        Domain::BLOB => {
+            if !nucleus_key_permission(caller_uid, key, KeyPerm::ManageBlob) {
+                return Err(nucleus_denied(
+                    caller_uid,
+                    KeyPerm::ManageBlob.name(),
+                    Some(key.nspace),
+                ));
+            }
+        }
+        Domain::APP | Domain::SELINUX => {}
+        _ => {
+            return Err(KsError::Rc(ResponseCode::INVALID_ARGUMENT))
+                .context(format!("Unknown domain value: \"{:?}\".", key.domain))
+        }
+    }
+
+    if nucleus_key_permission(caller_uid, key, perm) {
+        Ok(())
+    } else {
+        Err(nucleus_denied(caller_uid, perm.name(), Some(key.nspace)))
+    }
+}
