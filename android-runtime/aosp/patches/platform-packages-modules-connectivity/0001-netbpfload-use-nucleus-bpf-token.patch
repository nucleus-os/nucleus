+    __u32 size = 0;
+    const void* raw = btf__raw_data(btf, &size);
+    if (!raw) return -ENOMEM;
+
+    LIBBPF_OPTS(bpf_btf_load_opts, options,
+        .btf_flags = BPF_F_TOKEN_FD,
+        .token_fd = static_cast<__u32>(nucleusBpfToken.get()),
+    );
