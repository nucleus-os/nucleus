 static unsigned int page_size = static_cast<unsigned int>(getpagesize());
 
+static bool isNucleusContainer() {
+  static const bool value = getenv("NUCLEUS_ANDROID_CONTAINER") != nullptr;
+  return value;
+}
+
+static unique_fd nucleusBpfToken;
+
+static bool initializeNucleusBpfToken() {
+  if (!isNucleusContainer()) return true;
+  unique_fd bpffs(open("/sys/fs/bpf", O_DIRECTORY | O_RDONLY | O_CLOEXEC));
+  if (!bpffs.ok()) {
+    ALOGE("Failed to open delegated Nucleus bpffs: %s", strerror(errno));
+    return false;
+  }
+  union bpf_attr request = {};
+  request.token_create.bpffs_fd = bpffs;
+  nucleusBpfToken.reset(bpf(BPF_TOKEN_CREATE, request));
+  if (!nucleusBpfToken.ok()) {
+    ALOGE("Failed to create Nucleus BPF token: %s", strerror(errno));
+    return false;
+  }
+  return true;
+}
