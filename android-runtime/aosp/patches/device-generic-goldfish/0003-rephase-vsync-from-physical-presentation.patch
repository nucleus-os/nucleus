+HWC3::Error VsyncThread::rephase(
+        int64_t timestampNanos, int32_t periodNanos) {
+    if (timestampNanos <= 0 || periodNanos <= 0) {
+        return HWC3::Error::BadParameter;
+    }
+    {
+        std::unique_lock<std::mutex> lock(mStateMutex);
+        mPreviousVsync = TimePoint(Nanoseconds(timestampNanos));
+        mVsyncPeriod = Nanoseconds(periodNanos);
+        mPendingUpdate.reset();
+        ++mPhaseGeneration;
+    }
+    mStateCondition.notify_all();
+    return HWC3::Error::None;
+}
