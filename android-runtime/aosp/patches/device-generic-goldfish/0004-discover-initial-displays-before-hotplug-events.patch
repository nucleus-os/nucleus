From 8114d02379a3cbcd67c86fc572255a06843bb1c0 Mon Sep 17 00:00:00 2001
From: Nucleus Build <nucleus@localhost>
Date: Mon, 27 Jul 2026 19:10:00 -0600
Subject: [PATCH] Discover initial displays before hotplug events

Let each FrameComposer provide the complete initial display snapshot through
the initialization path. Hotplug callbacks then represent topology changes
that happen after subscription instead of being overloaded to synchronously
replay initial state while ComposerClient holds its display lock.

The default implementation retains the existing ranchu display discovery
path.
---
 hals/hwc3/ComposerClient.cpp | 2 +-
 hals/hwc3/FrameComposer.h    | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/hals/hwc3/ComposerClient.cpp b/hals/hwc3/ComposerClient.cpp
index 247fc99f..4dfc86b1 100644
--- a/hals/hwc3/ComposerClient.cpp
+++ b/hals/hwc3/ComposerClient.cpp
@@ -1315,7 +1315,7 @@ HWC3::Error ComposerClient::createDisplaysLocked() {
 
     std::vector<DisplayMultiConfigs> displays;
 
-    HWC3::Error error = findDisplays(mComposer->getDrmPresenter(), &displays);
+    HWC3::Error error = mComposer->getDisplayConfigurations(&displays);
     if (error != HWC3::Error::None) {
         ALOGE("%s failed to find display configs", __FUNCTION__);
         return error;
diff --git a/hals/hwc3/FrameComposer.h b/hals/hwc3/FrameComposer.h
index e316c1cc..8b655332 100644
--- a/hals/hwc3/FrameComposer.h
+++ b/hals/hwc3/FrameComposer.h
@@ -28,6 +28,7 @@
 
 #include "Common.h"
 #include "DisplayChanges.h"
+#include "DisplayFinder.h"
 
 namespace aidl::android::hardware::graphics::composer3::impl {
 
@@ -40,6 +41,11 @@ class FrameComposer {
 
     virtual HWC3::Error init() = 0;
 
+    virtual HWC3::Error getDisplayConfigurations(
+        std::vector<DisplayMultiConfigs>* outDisplays) {
+        return findDisplays(getDrmPresenter(), outDisplays);
+    }
+
     using HotplugCallback = std::function<void(bool /*connected*/,   //
                                                uint32_t /*id*/,      //
                                                uint32_t /*width*/,   //
-- 
