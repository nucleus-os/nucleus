FROM docker.io/library/ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bison \
        build-essential \
        ca-certificates \
        ccache \
        curl \
        file \
        flex \
        fontconfig \
        git-core \
        gnupg \
        libelf-dev \
        libgl1-mesa-dev \
        lz4 \
        libncurses6 \
        libssl-dev \
        libxml2-utils \
        libx11-dev \
        openssl \
        python3 \
        rsync \
        unzip \
        x11proto-core-dev \
        xsltproc \
        zip \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# AOSP's checked-in Linux host tools are x86_64 executables. The VM and base
# image remain arm64; macOS supplies Intel binary translation, while these
# runtime libraries satisfy dynamically linked prebuilts inside the guest.
RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        libc6:amd64 \
        libgcc-s1:amd64 \
        libstdc++6:amd64 \
        zlib1g:amd64 \
    && rm -rf /var/lib/apt/lists/*

RUN usermod \
        --login nucleus-build \
        --home /home/nucleus-build \
        --move-home \
        --shell /bin/bash \
        ubuntu \
    && groupmod --new-name nucleus-build ubuntu \
    && usermod \
        --groups '' \
        --comment 'Nucleus AOSP Build' \
        nucleus-build

USER nucleus-build
WORKDIR /src

ENV HOME=/home/nucleus-build \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC
