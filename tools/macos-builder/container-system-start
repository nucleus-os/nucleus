#!/bin/bash
set -euo pipefail

readonly container_executable="/usr/local/bin/container"
# One application root serves the host where a build store is installed, so the
# builder's service owns it and no second account runs a container service.
readonly build_store=/Library/Nucleus/Collider
if [[ -d "$build_store" ]]; then
  readonly app_root="$build_store/state/apple-container"
else
  readonly app_root="$HOME/Library/Developer/Nucleus/Collider/apple-container"
fi

if [[ ! -x "$container_executable" ]]; then
  echo "error: pinned Apple container executable is absent: $container_executable" >&2
  exit 69
fi

if [[ ! -d "$app_root" ]]; then
  echo "error: Apple container application root is absent: $app_root" >&2
  exit 75
fi

exec "$container_executable" system start \
  --app-root "$app_root" \
  --disable-kernel-install \
  --timeout 300
