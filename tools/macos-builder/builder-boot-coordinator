#!/bin/bash
# Restores the builder's per-user launchd services after a machine reboot.
#
# The runner and Apple Container API must share the builder's user bootstrap
# namespace. A root LaunchDaemon cannot host either service itself, but it can
# recreate that namespace and bootstrap the root-approved descriptors into it.
set -euo pipefail

if [[ $EUID -ne 0 || $# -ne 11 ]]; then
  echo "usage: $0 <builder-user> <builder-uid> <quarantine-marker> <container-label> <container-plist> <container-executable> <runner-label> <runner-plist> <runner-root> <watchdog-label> <watchdog-plist>" >&2
  exit 64
fi

readonly builder_user="$1"
readonly builder_uid="$2"
readonly quarantine_marker="$3"
readonly container_label="$4"
readonly container_plist="$5"
readonly container_executable="$6"
readonly runner_label="$7"
readonly runner_plist="$8"
readonly runner_root="$9"
readonly watchdog_label="${10}"
readonly watchdog_plist="${11}"
readonly service_domain="user/$builder_uid"

log() {
  printf '%s builder-boot-coordinator: %s\n' \
    "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1"
}

run_as_builder() {
  /bin/launchctl asuser "$builder_uid" \
    /usr/bin/sudo -H -u "$builder_user" "$@"
}

service_is_loaded() {
  /bin/launchctl print "$service_domain/$1" >/dev/null 2>&1
}

bootstrap_service() {
  local label="$1"
  local plist="$2"
  service_is_loaded "$label" && return 0
  [[ -f "$plist" && ! -L "$plist" ]] \
    || { log "service descriptor is absent: $plist"; return 66; }
  log "bootstrapping $label into $service_domain"
  run_as_builder /bin/launchctl bootstrap "$service_domain" "$plist"
}

container_is_healthy() {
  run_as_builder "$container_executable" system status --format json \
    >/dev/null 2>&1
}

runner_worker_is_active() {
  /bin/ps -axo command= \
    | /usr/bin/awk -v worker="$runner_root/bin/Runner.Worker" \
      '$1 == worker { found = 1 } END { exit(found ? 0 : 1) }'
}

if [[ -e "$quarantine_marker" || -L "$quarantine_marker" ]]; then
  log "builder is quarantined; refusing service recovery"
  exit 77
fi

if ! /bin/launchctl print "$service_domain" >/dev/null 2>&1; then
  log "creating $service_domain"
  /bin/launchctl bootstrap "$service_domain"
fi

bootstrap_service "$container_label" "$container_plist"
if ! container_is_healthy; then
  if runner_worker_is_active; then
    log "container service is unavailable while a runner job is active"
    exit 75
  fi
  log "starting $container_label"
  /bin/launchctl kickstart -k "$service_domain/$container_label"
  for _ in {1..60}; do
    container_is_healthy && break
    /bin/sleep 1
  done
fi
container_is_healthy \
  || { log "container service did not become healthy"; exit 70; }

# Only expose the runner to GitHub after the local execution substrate is
# healthy. Otherwise it can claim a protected-main job that is guaranteed to
# fail its host-contract preflight.
bootstrap_service "$runner_label" "$runner_plist"
bootstrap_service "$watchdog_label" "$watchdog_plist"
