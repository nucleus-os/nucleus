#!/bin/bash
set -euo pipefail

readonly builder_user="nucleus-builder"
readonly checkout_record="/Library/Nucleus/Builder/authoritative-checkout"

if [[ $EUID -ne 0 ]]; then
  echo "error: invoke this root-owned launcher through sudo" >&2
  exit 77
fi
if [[ $# -lt 3 || $# -gt 4 ]]; then
  echo "usage: nucleus-builder-run <canonical-checkout> <build|test|package|generate> <debug|release> [component]" >&2
  exit 64
fi
if [[ ! -f "$checkout_record" ]]; then
  echo "error: builder checkout contract is not installed" >&2
  exit 72
fi

readonly requested_checkout="$1"
readonly operation="$2"
readonly configuration="$3"
readonly component="${4:-}"
readonly checkout="$(/usr/bin/sed -n '1p' "$checkout_record")"
readonly canonical_requested="$(cd "$requested_checkout" 2>/dev/null && /bin/pwd -P)" || {
  echo "error: requested checkout does not exist" >&2
  exit 72
}
if [[ "$canonical_requested" != "$requested_checkout" || "$requested_checkout" != "$checkout" ]]; then
  echo "error: launcher accepts only the canonical authoritative checkout: $checkout" >&2
  exit 77
fi
if [[ ! -f "$checkout/Package.swift" || ! -x "$checkout/tools/collider-launcher.sh" ]]; then
  echo "error: authoritative checkout is incomplete" >&2
  exit 72
fi

# A component narrows an operation to one entry in the current catalog. It is
# matched against a strict name pattern rather than passed through, so this
# launcher still accepts a typed operation rather than an argument vector: no
# option, path, or second word can reach Collider through it. Release
# configurations already express themselves as a fixed selection, so combining
# the two would be ambiguous and is refused rather than silently resolved.
if [[ -n "$component" ]]; then
  if [[ ! "$component" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "error: component must be a catalog component name" >&2
    exit 64
  fi
  if [[ "$configuration" != debug ]]; then
    echo "error: a component is accepted only with the debug configuration" >&2
    exit 64
  fi
fi

case "$configuration:$operation" in
  debug:build) command=(build ${component:+"$component"}) ;;
  debug:test) command=(test ${component:+"$component"}) ;;
  # Generation writes the build store, so it runs as the builder, and it names
  # exactly one generator rather than defaulting to every one of them.
  debug:generate)
    if [[ -z "$component" ]]; then
      echo "error: generate requires a generator target" >&2
      exit 64
    fi
    command=(generate "$component")
    ;;
  release:build) command=(build linux-runtime) ;;
  release:test) command=(test release-gate) ;;
  release:package) command=(package linux-runtime) ;;
  *)
    echo "error: unsupported operation/configuration pair: $operation/$configuration" >&2
    exit 64
    ;;
esac

# launchd hands a process 256 open files by default, which is a desktop default
# rather than a build one: source capture alone runs Git once per checkout
# across dozens of submodules and SwiftPM checkout directories, and compilation
# opens far more. The ceiling is the kernel's per-process maximum.
ulimit -n "$(/usr/sbin/sysctl -n kern.maxfilesperproc)" 2>/dev/null || true

readonly builder_uid="$(/usr/bin/id -u "$builder_user")"
exec /bin/launchctl asuser "$builder_uid" /usr/bin/sudo -H -u "$builder_user" \
  /usr/bin/env -i \
    HOME="/Users/$builder_user" \
    USER="$builder_user" \
    LOGNAME="$builder_user" \
    PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    NUCLEUS_WORKSPACE_ROOT="$checkout" \
    NUCLEUS_REVALIDATE_SOURCE=1 \
    "$checkout/tools/collider-launcher.sh" "${command[@]}"
