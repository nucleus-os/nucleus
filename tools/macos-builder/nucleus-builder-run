#!/bin/bash
set -euo pipefail

readonly builder_user="nucleus-builder"
readonly checkout_record="/Library/Nucleus/Builder/authoritative-checkout"

if [[ $EUID -ne 0 ]]; then
  echo "error: invoke this root-owned launcher through sudo" >&2
  exit 77
fi
if [[ $# -lt 2 ]]; then
  echo "usage: nucleus-builder-run <canonical-checkout> <command-word>... [option]..." >&2
  exit 64
fi
if [[ ! -f "$checkout_record" ]]; then
  echo "error: builder checkout contract is not installed" >&2
  exit 72
fi

readonly requested_checkout="$1"
shift
readonly checkout="$(/usr/bin/sed -n '1p' "$checkout_record")"
readonly canonical_requested="$(cd "$requested_checkout" 2>/dev/null && /bin/pwd -P)" || {
  echo "error: requested checkout does not exist" >&2
  exit 72
}
if [[ "$canonical_requested" != "$requested_checkout" || "$requested_checkout" != "$checkout" ]]; then
  echo "error: launcher accepts only the canonical authoritative checkout: $checkout" >&2
  exit 77
fi
if [[ ! -f "$checkout/Package.swift" || ! -x "$checkout/tools/collider-launcher.sh" ]]; then
  echo "error: authoritative checkout is incomplete" >&2
  exit 72
fi

# The grant is password-free, so what crosses it is typed rather than passed
# through. Command words name a subcommand or a catalog selection and match a
# pattern that cannot express a path, an option, or a shell metacharacter.
# Options come from a closed list, each with its own value pattern. Together
# these keep the one exact program this grant admits from becoming a way to run
# anything else as another identity.
command=()
options=()
readonly maximum_words=4

expect_value() {
  [[ $# -ge 2 ]] || { echo "error: $1 requires a value" >&2; exit 64; }
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild|--dry-run|--verbose|--quiet|--measure-allocations)
      options+=("$1")
      shift
      ;;
    --format|--progress-format)
      expect_value "$@"
      [[ "$2" =~ ^(text|json|human)$ ]] \
        || { echo "error: $1 accepts text, json, or human" >&2; exit 64; }
      options+=("$1" "$2")
      shift 2
      ;;
    --color|--progress)
      expect_value "$@"
      [[ "$2" =~ ^(auto|always|never)$ ]] \
        || { echo "error: $1 accepts auto, always, or never" >&2; exit 64; }
      options+=("$1" "$2")
      shift 2
      ;;
    --run-id)
      expect_value "$@"
      [[ "$2" =~ ^[0-9A-Za-z:._-]{1,128}$ ]] \
        || { echo "error: --run-id is not a run identifier" >&2; exit 64; }
      options+=("$1" "$2")
      shift 2
      ;;
    -*)
      echo "error: option is not admitted through this launcher: $1" >&2
      exit 64
      ;;
    *)
      [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || { echo "error: command word is not a Collider command word: $1" >&2; exit 64; }
      [[ ${#command[@]} -lt $maximum_words ]] \
        || { echo "error: too many command words" >&2; exit 64; }
      command+=("$1")
      shift
      ;;
  esac
done

[[ ${#command[@]} -gt 0 ]] || { echo "error: no command words given" >&2; exit 64; }
# Expanding an empty array under `set -u` is an error in the bash this host
# ships, so the append is conditional rather than unconditional.
if [[ ${#options[@]} -gt 0 ]]; then
  command+=("${options[@]}")
fi

# launchd hands a process 256 open files by default, which is a desktop default
# rather than a build one: source capture alone runs Git once per checkout
# across dozens of submodules and SwiftPM checkout directories, and compilation
# opens far more. The ceiling is the kernel's per-process maximum.
ulimit -n "$(/usr/sbin/sysctl -n kern.maxfilesperproc)" 2>/dev/null || true

# The builder inherits this working directory, and it reaches exactly one tree.
# Invoked from anywhere else -- the developer's home most of all, which the
# builder may not read at all -- every child fails to resolve its own current
# directory before it runs. This is the single entry point for builder
# execution, so anchoring here is what spares each of them from knowing.
cd "$checkout" || {
  echo "error: cannot enter the authoritative checkout: $checkout" >&2
  exit 72
}

readonly builder_uid="$(/usr/bin/id -u "$builder_user")"
exec /bin/launchctl asuser "$builder_uid" /usr/bin/sudo -H -u "$builder_user" \
  /usr/bin/env -i \
    HOME="/Users/$builder_user" \
    USER="$builder_user" \
    LOGNAME="$builder_user" \
    PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    NUCLEUS_WORKSPACE_ROOT="$checkout" \
    NUCLEUS_REVALIDATE_SOURCE=1 \
    "$checkout/tools/collider-launcher.sh" "${command[@]}"
