// SwiftPM-owned module map for the first-party text-layout C++ bridge. This
// directory holds exactly one map so clang never auto-loads two for one include
// dir. `TextLayoutBuilder.hpp` is a byte-identical copy of
// core/render-cxx/skia/include/nucleus/text/TextLayoutBuilder.hpp and must be
// edited alongside it. Header-only: the implementation lives in
// libnucleus-text-backend.so (linked later).
module NucleusTextCxxBridge {
    requires cplusplus
    header "TextLayoutBuilder.hpp"
    export *
}
