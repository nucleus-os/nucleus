#!/bin/bash
set -euo pipefail

: "${ANDROID_NDK_HOME:?ANDROID_NDK_HOME is required}"
: "${NUCLEUS_ANDROID_TARGET:?NUCLEUS_ANDROID_TARGET is required}"

exec /usr/bin/clang++ \
  --target="$NUCLEUS_ANDROID_TARGET" \
  --sysroot="$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/sysroot" \
  "$@"
